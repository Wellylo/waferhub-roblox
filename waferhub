local function checkAndBindDevice(cleanKey, keyInfo)
    local currentHWID = getClientHWID()
    local username = player.Name
    local userId = tostring(player.UserId)

    -- Check if key is permanently expired
    local expiredKeys = {}
    if isfile and isfile("wafer_expired_keys.json") then
