-- Algorithmic Checksum Verification
local function verifyKeyChecksum(cleanKey)
    if #cleanKey ~= 32 then return false end
    
    local first30 = string.sub(cleanKey, 1, 30)
    local expectedC1C2 = string.sub(cleanKey, 31, 32)
    
    local charSum = 0
    for i = 1, 30 do
        charSum = charSum + string.byte(first30, i)
    end
    
    -- V2 Salted Checksum Algorithm
    local idx1 = (((charSum * 19 + 7) % 36) + 1)
    local idx2 = (((charSum * 23 + 13) % 36) + 1)
    
    local calcC1 = string.sub(BASE36, idx1, idx1)
    local calcC2 = string.sub(BASE36, idx2, idx2)
    
    return (calcC1 .. calcC2) == expectedC1C2
end

