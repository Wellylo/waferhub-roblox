local function attemptVerify(inputKeyText)
    local cleanKey=string.upper(string.gsub(inputKeyText or "","%s+",""))
    local isValid,message,badgeText,keyData=validateKey(cleanKey)
    if isValid then
        if writefile then pcall(function()
            if cleanKey:sub(1,5)~="WAF0-" then writefile("wafer_saved_key.txt",cleanKey)
            else if isfile and isfile("wafer_saved_key.txt") then delfile("wafer_saved_key.txt") end end
        end) end
        statusLabel.Text=message; statusLabel.TextColor3=COLOR_GREEN
        task.wait(0.5); loadMainWaferHub(badgeText,keyData,cleanKey); return true
    else
        statusLabel.Text=message; statusLabel.TextColor3=COLOR_RED; return false
    end
end

