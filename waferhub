        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.Parent = card

        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(0, 36)
        pad.PaddingBottom = UDim.new(0, 12)
        pad.PaddingLeft = UDim.new(0, 12)
        pad.PaddingRight = UDim.new(0, 12)
        pad.Parent = card

        return card
    end

    local function addToggle(card, text, defaultState, callback)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 26)
        row.BackgroundTransparency = 1
        row.Parent = card

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.7, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = text
        label.TextColor3 = COLOR_TEXT_MAIN
        label.Font = Enum.Font.GothamMedium
        label.TextSize = 13
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = row

        local switch = Instance.new("TextButton")
        switch.Size = UDim2.new(0, 44, 0, 24)
        switch.Position = UDim2.new(1, -44, 0.5, -12)
        switch.BackgroundColor3 = defaultState and COLOR_BABY_BLUE or Color3.fromRGB(210, 222, 235)
        switch.Text = ""
        switch.AutoButtonColor = false
        switch.Parent = row

        local switchCorner = Instance.new("UICorner")
        switchCorner.CornerRadius = UDim.new(1, 0)
        switchCorner.Parent = switch

        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 18, 0, 18)
        knob.Position = defaultState and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel = 0
        knob.Parent = switch

        local knobCorner = Instance.new("UICorner")
        knobCorner.CornerRadius = UDim.new(1, 0)
        knobCorner.Parent = knob

        local state = defaultState
        switch.MouseButton1Click:Connect(function()
            state = not state
            TweenService:Create(switch, TweenInfo.new(0.2), {BackgroundColor3 = state and COLOR_BABY_BLUE or Color3.fromRGB(210, 222, 235)}):Play()
            TweenService:Create(knob, TweenInfo.new(0.2), {Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)}):Play()
            callback(state)
        end)
    end

    local function addSlider(card, text, min, max, default, callback)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 44)
        row.BackgroundTransparency = 1
        row.Parent = card

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.7, 0, 0, 18)
        label.BackgroundTransparency = 1
        label.Text = text
        label.TextColor3 = COLOR_TEXT_MAIN
        label.Font = Enum.Font.GothamMedium
        label.TextSize = 13
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = row

        local valLabel = Instance.new("TextLabel")
        valLabel.Size = UDim2.new(0.3, 0, 0, 18)
        valLabel.Position = UDim2.new(0.7, 0, 0, 0)
        valLabel.BackgroundTransparency = 1
        valLabel.Text = tostring(default) .. "/" .. tostring(max)
        valLabel.TextColor3 = COLOR_BABY_BLUE_DARK
        valLabel.Font = Enum.Font.GothamBold
        valLabel.TextSize = 12
        valLabel.TextXAlignment = Enum.TextXAlignment.Right
        valLabel.Parent = row

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, 0, 0, 10)
        track.Position = UDim2.new(0, 0, 0, 26)
        track.BackgroundColor3 = Color3.fromRGB(215, 228, 240)
        track.BorderSizePixel = 0
        track.Parent = row

        local trackCorner = Instance.new("UICorner")
        trackCorner.CornerRadius = UDim.new(1, 0)
        trackCorner.Parent = track

        local fill = Instance.new("Frame")
        local pct = (default - min) / (max - min)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        fill.BackgroundColor3 = COLOR_BABY_BLUE
        fill.BorderSizePixel = 0
        fill.Parent = track

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(1, 0)
        fillCorner.Parent = fill

        local dragging = false
        local function updateSlider(input)
            local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            local value = math.floor(min + (max - min) * pos)
            fill.Size = UDim2.new(pos, 0, 1, 0)
            valLabel.Text = tostring(value) .. "/" .. tostring(max)
            callback(value)
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                updateSlider(input)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateSlider(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    local function addButton(card, text, callback)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 34)
        btn.BackgroundColor3 = COLOR_HEADER
        btn.Text = text
        btn.TextColor3 = COLOR_BABY_BLUE_DARK
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 13
        btn.AutoButtonColor = false
        btn.Parent = card

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 8)
        btnCorner.Parent = btn

        local btnStroke = Instance.new("UIStroke")
        btnStroke.Color = COLOR_STROKE
        btnStroke.Thickness = 1
        btnStroke.Parent = btn

        btn.MouseButton1Click:Connect(callback)
    end

    local mainPage = createTab("Main")
    local physicsPage = createTab("Physics")
    local settingsPage = createTab("Settings")

    local magCard = createCard(mainPage, "Magnets")
    addToggle(magCard, "Enable Magnets", false, function(val)
        getgenv().MagsActivated = val
        if not val then removeHitboxes() end
    end)
    addToggle(magCard, "Show Visual Hitbox", false, function(val)
        getgenv().ShowHitbox = val
        if not val then removeHitboxes() end
    end)
    addSlider(magCard, "Magnet Distance", 1, 100, 10, function(val)
        getgenv().MagsRange = val
    end)

    local pullCard = createCard(mainPage, "Pull Vector")
    addToggle(pullCard, "Enable Pull Vector", false, function(val)
        getgenv().PullEnabled = val
        pullButton.Visible = val
        if not val then
            pullButtonHeld = false
            pullButton.BackgroundColor3 = COLOR_BABY_BLUE
        end
    end)
    addSlider(pullCard, "Pull Power", 1, 25, 10, function(val)
        getgenv().PullPower = val
    end)

    local speedCard = createCard(physicsPage, "CFrame Speed")
    addToggle(speedCard, "Enable Speed Boost", false, function(val)
        getgenv().SpeedEnabled = val
        if val then startMovementSystem() else stopMovementSystem() end
    end)
    addSlider(speedCard, "Speed Multiplier", 1, 5, 1, function(val)
        getgenv().SpeedValue = val
    end)

    local jumpCard = createCard(physicsPage, "Jump Power")
    addToggle(jumpCard, "Enable Jump Boost", false, function(val)
        getgenv().JumpPowerOn = val
    end)
    addSlider(jumpCard, "Jump Boost Power", 50, 120, 50, function(val)
        getgenv().JumpBoost = val
    end)

    local tackleCard = createCard(physicsPage, "Tackle Controls")
    addToggle(tackleCard, "Click Tackle Teleport", false, function(val)
        getgenv().ClickTackleEnabled = val
        if val then enableClickTackle() else disableClickTackle() end
    end)
    addSlider(tackleCard, "Tackle Range", 1, 30, 15, function(val)
        getgenv().ClickTackleRange = val
    end)

    local menuCard = createCard(settingsPage, "Menu Controls")
    addButton(menuCard, "Unload Wafer Hub Script", function()
        getgenv().MagsActivated = false
        getgenv().ShowHitbox = false
        getgenv().SpeedEnabled = false
        getgenv().JumpPowerOn = false
        getgenv().PullEnabled = false
        getgenv().ClickTackleEnabled = false
        removeHitboxes()
        stopMovementSystem()
        disableClickTackle()
        if pullButtonGui then pullButtonGui:Destroy() end
        if mainGui then mainGui:Destroy() end
    end)

    switchTab(tabs["Main"].Btn, tabs["Main"].Page)

    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == getgenv().MenuKey then
            mainFrame.Visible = not mainFrame.Visible
        end
    end)

    print("Wafer Hub unlocked successfully!")
end

-- Key Verification Handler
verifyBtn.MouseButton1Click:Connect(function()
    statusLabel.Text = "Checking key..."
    statusLabel.TextColor3 = COLOR_TEXT_MUTED
    task.wait(0.2)

    local isValid, message = validateKey(keyInput.Text)
    if isValid then
        statusLabel.Text = message
        statusLabel.TextColor3 = COLOR_GREEN
        task.wait(0.6)
        loadMainWaferHub()
    else
        statusLabel.Text = message
        statusLabel.TextColor3 = COLOR_RED
    end
end)
