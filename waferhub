-- Fallback Key Database (Hosted URL: https://raw.githubusercontent.com/Wellylo/waferhub-roblox/main/keys.json)
local KEYS_URL = "https://raw.githubusercontent.com/Wellylo/waferhub-roblox/main/keys.json"

local defaultKeys = {
    lifetime = {
        ["WAFER-LIFE-8F92A"] = true,
        ["WAFER-LIFE-3X71K"] = true,
        ["WAFER-LIFE-LIFETIME"] = true
    },
    weekly = {
        ["WAFER-WEEK-A1B2C"] = 9999999999, -- Expiration unix timestamp
        ["WAFER-WEEK-7DAYS"] = 9999999999
    }
}

local function fetchKeys()
    local success, response = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(KEYS_URL))
    end)
    if success and type(response) == "table" then
        return response
    end
    return defaultKeys
end

local function validateKey(inputKey)
    local keysData = fetchKeys()
    local cleanKey = string.upper(string.gsub(inputKey or "", "%s+", ""))
    
    if not cleanKey or cleanKey == "" then
        return false, "Please enter a key!"
    end

    -- Check Lifetime Keys
    if keysData.lifetime then
        if type(keysData.lifetime) == "table" then
            for _, k in pairs(keysData.lifetime) do
                if type(k) == "string" and string.upper(k) == cleanKey then
                    return true, "Lifetime Access Granted!"
                elseif keysData.lifetime[cleanKey] then
                    return true, "Lifetime Access Granted!"
                end
            end
        end
    end

    -- Check 1-Week Keys
    if keysData.weekly and type(keysData.weekly) == "table" then
        for k, expiry in pairs(keysData.weekly) do
            if string.upper(tostring(k)) == cleanKey then
                local currentTime = os.time()
                if type(expiry) == "number" and expiry > currentTime then
                    local daysLeft = math.ceil((expiry - currentTime) / 86400)
                    return true, "1-Week Key Valid (" .. tostring(daysLeft) .. " days remaining)"
                elseif type(expiry) == "number" then
                    return false, "Key Expired!"
                else
                    return true, "1-Week Key Valid!"
                end
            end
        end
    end

    return false, "Invalid Key!"
end

