                    local hrp = character.HumanoidRootPart
                    local range = getgenv().MagsRange or 10
                    
                    local ballVel = v.AssemblyLinearVelocity or v.Velocity or Vector3.zero
                    local predictedPos = v.Position + (ballVel * 0.04)
                    local dist = (predictedPos - hrp.Position).Magnitude
                    local realDist = (v.Position - hrp.Position).Magnitude
                    
                    if dist <= range or realDist <= range then
                        v.CanCollide = false
                        
                        local targetHandsCFrame = hrp.CFrame * CFrame.new(0, 0.5, -0.8)
                        local strength = getgenv().MagsStrength or 50
                        
                        if strength >= 100 then
                            v.CFrame = targetHandsCFrame
                        else
                            local yDiff = predictedPos.Y - hrp.Position.Y
                            local dynamicY = math.clamp(yDiff * 0.4, -1.2, 2.2) + 0.4
                            
                            local radius = math.clamp(realDist * 0.25, 0.4, 2.2)
                            local orbitOffset = Vector3.new(
                                math.cos(orbitAngle) * radius,
                                dynamicY,
                                math.sin(orbitAngle) * radius
                            )
                            local orbitCFrame = hrp.CFrame * CFrame.new(orbitOffset)
                            
                            local strengthFactor = math.clamp(strength / 100, 0.05, 0.99)
                            local blendWeight = math.clamp((1 - (realDist / range)) * (0.3 + strengthFactor * 0.6), 0.15, 0.95)
                            local targetCFrame = orbitCFrame:Lerp(targetHandsCFrame, blendWeight)
                            
                            local lerpAlpha = math.clamp(dt * (10 + strengthFactor * 30) + (1 - math.clamp(realDist / range, 0, 1)) * (strengthFactor * 0.5), 0.1, 0.95)
                            v.CFrame = v.CFrame:Lerp(targetCFrame, lerpAlpha)
                        end
                        
                        -- Direct Velocity Vector toward player hands
                        local pullDir = (targetHandsCFrame.Position - v.Position)
                        if pullDir.Magnitude > 0.1 then
                            pcall(function()
                                local curSpeed = math.clamp(ballVel.Magnitude, 15, 45)
                                v.AssemblyLinearVelocity = pullDir.Unit * curSpeed
                            end)
                        end
                        
                        -- Continuous Catch Touch Trigger on HRP & Catch parts
                        local catchRight = character:FindFirstChild("CatchRight") or character:FindFirstChild("RightHand")
                        local catchLeft = character:FindFirstChild("CatchLeft") or character:FindFirstChild("LeftHand")
                        
                        if firetouchinterest then
                            pcall(function()
                                firetouchinterest(hrp, v, 0)
                                firetouchinterest(hrp, v, 1)
                                if catchRight then
                                    firetouchinterest(catchRight, v, 0)
                                    firetouchinterest(catchRight, v, 1)
                                end
                                if catchLeft then
                                    firetouchinterest(catchLeft, v, 0)
                                    firetouchinterest(catchLeft, v, 1)
                                end
                            end)
                        end
                    end
                end
            end
        end
    end)

