    local function findClosestBallCarrier(maxDistance)
        local char=player.Character; if not char then return nil end
        local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return nil end
        local closestDist,closestChar=maxDistance,nil
        for _,plr in ipairs(Players:GetPlayers()) do
            if plr==player then continue end
            local tc=plr.Character; if not tc then continue end
            local thrp=tc:FindFirstChild("HumanoidRootPart"); if not thrp then continue end
            local hasFB=tc:FindFirstChild("Football")~=nil
            if not hasFB then for _,item in ipairs(tc:GetChildren()) do if (item:IsA("Tool") or item:IsA("BasePart")) and item.Name:match("Football") then hasFB=true; break end end end
            if not hasFB then continue end
            local dist=(hrp.Position-thrp.Position).Magnitude
            if dist<closestDist then closestDist=dist; closestChar=tc end
        end
        return closestChar
    end

