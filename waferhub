                    writefile("keys.json",HttpService:JSONEncode(kd))
                end
            end)
        end
        return true,nil,activatedAt
    end
end

local defaultKeys={keys={}}

local function fetchKeys()
    local combinedKeys={}
    local function mergeTable(tbl)
        if type(tbl)~="table" then return end
        local src=tbl.keys or tbl
        for k,v in pairs(src) do
            if type(k)=="string" then
                local uk=string.upper(string.gsub(k,"%s+",""))
                if type(v)=="table" then combinedKeys[uk]=v end
            end
        end
    end
    mergeTable(defaultKeys)
    if isfile and isfile("keys.json") then pcall(function() mergeTable(HttpService:JSONDecode(readfile("keys.json"))) end) end
    pcall(function() mergeTable(HttpService:JSONDecode(game:HttpGet(KEYS_URL))) end)
    return combinedKeys
end

local function validateKey(inputKey)
    local cleanKey=string.upper(string.gsub(inputKey or "","%s+",""))
    if not cleanKey or cleanKey=="" then return false,"Please enter your 32-character key!","",nil end
    if #cleanKey~=32 then return false,"Key must be exactly 32 characters!","",nil end
    if not verifyKeyChecksum(cleanKey) then return false,"Invalid Key! (Old or invalid signature)","",nil end
    local allKeys=fetchKeys()
    local keyInfo=allKeys[cleanKey]
    if keyInfo then
        if keyInfo.status=="revoked" then return false,"This Key Has Been Revoked!","",nil end
    else
        if allKeys and next(allKeys)~=nil then return false,"This Key Has Been Revoked / Expired!","",nil end
    end
    -- Anti-share: if key is locked to a specific user ID, reject everyone else
    if keyInfo and keyInfo.lock_user_id and tostring(keyInfo.lock_user_id)~="" and tostring(keyInfo.lock_user_id)~="null" then
        if tostring(keyInfo.lock_user_id)~=tostring(player.UserId) then
            return false,"This key doesn't belong to you.","",nil
        end
    end
    local isAllowed,lockError,firstActivationTime=checkAndBindDevice(cleanKey,keyInfo)
    if not isAllowed then return false,lockError,"",nil end
    local prefix=string.sub(cleanKey,1,5)
    local keyType,duration,typeName="daily",86400,"1-Day Key"
    if prefix=="WAF0-" then keyType,duration,typeName="test",20,"20s Test Key"
    elseif prefix=="WAF1-" then keyType,duration,typeName="daily",86400,"1-Day Key"
    elseif prefix=="WAF7-" then keyType,duration,typeName="weekly",604800,"1-Week Key"
    elseif prefix=="WAF3-" then keyType,duration,typeName="monthly",2592000,"1-Month Key"
    elseif prefix=="WAFL-" then keyType,duration,typeName="lifetime",0,"Lifetime Key"
    elseif keyInfo then
        keyType=tostring(keyInfo.type or "daily"):lower(); duration=tonumber(keyInfo.duration) or 86400
        if keyType=="20_sec" or duration==20 then typeName="20s Test Key"
        elseif keyType=="lifetime" or duration==0 then typeName="Lifetime Key"
        elseif keyType=="weekly" or duration==604800 then typeName="1-Week Key"
        elseif keyType=="monthly" or duration==2592000 then typeName="1-Month Key"
        else typeName="1-Day Key" end
    end
    if keyType=="lifetime" or duration==0 then
        return true,"Lifetime Access Granted!","Lifetime Key",{typeName="Lifetime Key",duration=0,activatedAt=firstActivationTime}
    end
    local currentTime=os.time()
    -- created_at in keys.json is the authoritative start: timer begins when YOU generate the key
    -- falls back to local bound file activation time, then current time as last resort
    local activatedAt=(keyInfo and tonumber(keyInfo.created_at)) or firstActivationTime or (keyInfo and tonumber(keyInfo.activated_at)) or currentTime
    local expiryTime=activatedAt+duration
    if currentTime>=expiryTime then
        if writefile then pcall(function()
            local exp={}
            if isfile and isfile("wafer_expired_keys.json") then exp=HttpService:JSONDecode(readfile("wafer_expired_keys.json")) end
            if type(exp)~="table" then exp={} end
            exp[cleanKey]={expired_at=currentTime,hwid=getClientHWID()}
            writefile("wafer_expired_keys.json",HttpService:JSONEncode(exp))
            if isfile and isfile("wafer_saved_key.txt") then delfile("wafer_saved_key.txt") end
        end) end
        return false,"Key Expired! (Time limit reached and key destroyed)","",nil
    end
    local secLeft=expiryTime-currentTime
    return true,typeName.." Valid!",typeName.." ("..tostring(secLeft).."s left)",
        {cleanKey=cleanKey,typeName=typeName,duration=duration,activatedAt=activatedAt,expiryTime=expiryTime}
end

