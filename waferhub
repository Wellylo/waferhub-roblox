            expiredKeys = HttpService:JSONDecode(readfile("wafer_expired_keys.json"))
        end)
    end
    if type(expiredKeys) == "table" and expiredKeys[cleanKey] then
        return false, "This key has expired and cannot be used again!", nil
    end

    local boundData = {}
    
    if isfile and isfile("wafer_bound_keys.json") then
        pcall(function()
            boundData = HttpService:JSONDecode(readfile("wafer_bound_keys.json"))
        end)
    end
    if type(boundData) ~= "table" then boundData = {} end

    -- Check HTTP remote gateway device lock
    local httpReq = (syn and syn.request) or (http and http.request) or http_request or request
    if httpReq then
        pcall(function()
            local res = httpReq({
                Url = "https://wafer-hub-key-system.glitch.me/api/activate",
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({
                    key = cleanKey,
                    hwid = currentHWID,
                    username = username,
                    userId = userId
                })
            })
            if res and res.Body then
                local body = HttpService:JSONDecode(res.Body)
                if body and body.success == false and body.message then
                    return false, body.message, nil
                end
            end
        end)
    end
    
    -- Check if key is bound in keys.json database first
    if keyInfo and type(keyInfo) == "table" then
        if keyInfo.hwid and tostring(keyInfo.hwid) ~= "" and tostring(keyInfo.hwid) ~= currentHWID then
            local boundUser = keyInfo.username or "another user"
            return false, "This key belongs to @" .. tostring(boundUser) .. "! (Anti-Share Lock)", nil
        end
        if keyInfo.user_id and tostring(keyInfo.user_id) ~= "" and tostring(keyInfo.user_id) ~= userId then
            local boundUser = keyInfo.username or "another user"
            return false, "This isn't your key! Bound to @" .. tostring(boundUser), nil
        end
    end
    
    -- Check local workspace binding file
    local keyBinding = boundData[cleanKey]
    if keyBinding and type(keyBinding) == "table" then
        if keyBinding.hwid and tostring(keyBinding.hwid) ~= currentHWID then
            local boundUser = keyBinding.username or "another user"
            return false, "This isn't your key! Bound to @" .. tostring(boundUser), nil
        end
        if keyBinding.user_id and tostring(keyBinding.user_id) ~= userId then
            local boundUser = keyBinding.username or "another user"
            return false, "This isn't your key! Bound to @" .. tostring(boundUser), nil
        end
        keyBinding.username = username
        keyBinding.user_id = userId
        if writefile then
            pcall(function()
                writefile("wafer_bound_keys.json", HttpService:JSONEncode(boundData))
            end)
        end
        return true, nil, tonumber(keyBinding.activated_at) or os.time()
    else
        local activatedAt = os.time()
        boundData[cleanKey] = {
            hwid = currentHWID,
            username = username,
            user_id = userId,
            activated_at = activatedAt
        }
        if writefile then
            pcall(function()
                writefile("wafer_bound_keys.json", HttpService:JSONEncode(boundData))
            end)
        end
        
        -- Save binding to keys.json if writefile available
        if isfile and isfile("keys.json") and writefile then
            pcall(function()
                local kcontent = readfile("keys.json")
                local kdecoded = HttpService:JSONDecode(kcontent)
                if kdecoded and kdecoded.keys and kdecoded.keys[cleanKey] then
                    kdecoded.keys[cleanKey].hwid = currentHWID
                    kdecoded.keys[cleanKey].username = username
                    kdecoded.keys[cleanKey].user_id = userId
                    kdecoded.keys[cleanKey].activated_at = activatedAt
                    writefile("keys.json", HttpService:JSONEncode(kdecoded))
                end
            end)
        end
        
        return true, nil, activatedAt
    end
end

local defaultKeys = {
    keys = {}
}

local function fetchKeys()
    local combinedKeys = {}

    local function mergeTable(tbl)
        if type(tbl) ~= "table" then return end
        local sourceKeys = tbl.keys or tbl
        for k, v in pairs(sourceKeys) do
            if type(k) == "string" then
                local upperK = string.upper(string.gsub(k, "%s+", ""))
                if type(v) == "table" then
                    combinedKeys[upperK] = v
                end
            end
        end
    end

    mergeTable(defaultKeys)

    if isfile and isfile("keys.json") then
        pcall(function()
            local content = readfile("keys.json")
            local decoded = HttpService:JSONDecode(content)
            mergeTable(decoded)
        end)
    end

    pcall(function()
        local remoteContent = game:HttpGet(KEYS_URL)
        local decoded = HttpService:JSONDecode(remoteContent)
        mergeTable(decoded)
    end)

    return combinedKeys
end

local function validateKey(inputKey)
    local cleanKey = string.upper(string.gsub(inputKey or "", "%s+", ""))
    
    if not cleanKey or cleanKey == "" then
        return false, "Please enter your 32-character key!", "", nil
    end

    if #cleanKey ~= 32 then
        return false, "Key must be exactly 32 characters!", "", nil
    end

    local isValidSignature = verifyKeyChecksum(cleanKey)
    if not isValidSignature then
        return false, "Invalid Key! (Old or invalid signature)", "", nil
    end

    local allKeys = fetchKeys()
    local keyInfo = allKeys[cleanKey]

    if keyInfo then
        if keyInfo.status == "revoked" then
            return false, "This Key Has Been Revoked!", "", nil
        end
    else
        if allKeys and next(allKeys) ~= nil then
            return false, "This Key Has Been Revoked / Expired!", "", nil
        end
    end

    -- First-Person Anti-Share Device Lock
    local isAllowed, lockError, firstActivationTime = checkAndBindDevice(cleanKey, keyInfo)
    if not isAllowed then
        return false, lockError, "", nil
    end

    -- Extract Key Duration & Type
    local prefix = string.sub(cleanKey, 1, 5)
    local keyType = "daily"
    local duration = 86400
    local typeName = "1-Day Key"

    if prefix == "WAF0-" then
        keyType = "test"
        duration = 20
        typeName = "20s Test Key"
    elseif prefix == "WAF1-" then
        keyType = "daily"
        duration = 86400
        typeName = "1-Day Key"
    elseif prefix == "WAF7-" then
        keyType = "weekly"
        duration = 604800
        typeName = "1-Week Key"
    elseif prefix == "WAF3-" then
        keyType = "monthly"
        duration = 2592000
        typeName = "1-Month Key"
    elseif prefix == "WAFL-" then
        keyType = "lifetime"
        duration = 0
        typeName = "Lifetime Key"
    elseif keyInfo then
        keyType = tostring(keyInfo.type or "daily"):lower()
        duration = tonumber(keyInfo.duration) or 86400
        if keyType == "20_sec" or duration == 20 then typeName = "20s Test Key"
        elseif keyType == "lifetime" or duration == 0 then typeName = "Lifetime Key"
        elseif keyType == "weekly" or duration == 604800 then typeName = "1-Week Key"
        elseif keyType == "monthly" or duration == 2592000 then typeName = "1-Month Key"
        else typeName = "1-Day Key" end
    end

    if keyType == "lifetime" or duration == 0 then
        return true, "Lifetime Access Granted!", "Lifetime Key", { typeName = "Lifetime Key", duration = 0, activatedAt = firstActivationTime }
    end

    local currentTime = os.time()
    local activatedAt = firstActivationTime or (keyInfo and tonumber(keyInfo.activated_at)) or currentTime
    local expiryTime = activatedAt + duration

    if currentTime >= expiryTime then
        if writefile then
            pcall(function()
                local exp = {}
                if isfile and isfile("wafer_expired_keys.json") then
                    exp = HttpService:JSONDecode(readfile("wafer_expired_keys.json"))
                end
                if type(exp) ~= "table" then exp = {} end
                exp[cleanKey] = { expired_at = currentTime, hwid = currentHWID }
                writefile("wafer_expired_keys.json", HttpService:JSONEncode(exp))
                if isfile and isfile("wafer_saved_key.txt") then
                    delfile("wafer_saved_key.txt")
                end
            end)
        end
        return false, "Key Expired! (Time limit reached and key destroyed)", "", nil
    end

    local secLeft = expiryTime - currentTime
    local badgeText = typeName .. " (" .. tostring(secLeft) .. "s left)"

    return true, typeName .. " Valid!", badgeText, { cleanKey = cleanKey, typeName = typeName, duration = duration, activatedAt = activatedAt, expiryTime = expiryTime }
end

