    end
    if type(expiredKeys)=="table" and expiredKeys[cleanKey] then
        return false,"This key has expired and cannot be used again!",nil
    end
    local boundData = {}
    if isfile and isfile("wafer_bound_keys.json") then
        pcall(function() boundData = HttpService:JSONDecode(readfile("wafer_bound_keys.json")) end)
    end
    if type(boundData)~="table" then boundData={} end
    local httpReq = (syn and syn.request) or (http and http.request) or http_request or request
    if httpReq then
        pcall(function()
            local res = httpReq({Url="https://wafer-hub-key-system.glitch.me/api/activate",Method="POST",
                Headers={["Content-Type"]="application/json"},
                Body=HttpService:JSONEncode({key=cleanKey,hwid=currentHWID,username=username,userId=userId})})
            if res and res.Body then
                local body=HttpService:JSONDecode(res.Body)
                if body and body.success==false and body.message then return false,body.message,nil end
            end
        end)
    end
    if keyInfo and type(keyInfo)=="table" then
        if keyInfo.hwid and tostring(keyInfo.hwid)~="" and tostring(keyInfo.hwid)~=currentHWID then
            return false,"This key belongs to @"..tostring(keyInfo.username or "another user").."! (Anti-Share Lock)",nil
        end
        if keyInfo.user_id and tostring(keyInfo.user_id)~="" and tostring(keyInfo.user_id)~=userId then
            return false,"This isn't your key! Bound to @"..tostring(keyInfo.username or "another user"),nil
        end
    end
    local keyBinding = boundData[cleanKey]
    if keyBinding and type(keyBinding)=="table" then
        if keyBinding.hwid and tostring(keyBinding.hwid)~=currentHWID then
            return false,"This isn't your key! Bound to @"..tostring(keyBinding.username or "another user"),nil
        end
        if keyBinding.user_id and tostring(keyBinding.user_id)~=userId then
            return false,"This isn't your key! Bound to @"..tostring(keyBinding.username or "another user"),nil
        end
        keyBinding.username=username; keyBinding.user_id=userId
        if writefile then pcall(function() writefile("wafer_bound_keys.json",HttpService:JSONEncode(boundData)) end) end
        return true,nil,tonumber(keyBinding.activated_at) or os.time()
    else
        local activatedAt=os.time()
        boundData[cleanKey]={hwid=currentHWID,username=username,user_id=userId,activated_at=activatedAt}
        if writefile then pcall(function() writefile("wafer_bound_keys.json",HttpService:JSONEncode(boundData)) end) end
        if isfile and isfile("keys.json") and writefile then
