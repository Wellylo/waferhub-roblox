local function attemptVerify(inputKeyText)
    local isValid, message, badgeText, keyData = validateKey(inputKeyText)
    if isValid then
        if writefile then
            pcall(function()
                writefile("wafer_saved_key.txt", string.upper(string.gsub(inputKeyText or "", "%s+", "")))
            end)
        end
        statusLabel.Text = message
        statusLabel.TextColor3 = COLOR_GREEN
        task.wait(0.5)
        loadMainWaferHub(badgeText, keyData)
        return true
    else
        statusLabel.Text = message
        statusLabel.TextColor3 = COLOR_RED
        return false
    end
end

